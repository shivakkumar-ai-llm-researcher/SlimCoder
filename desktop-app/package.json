{
  "name": "slm-desktop",
  "version": "1.0.0",
  "description": "Antigravity 2.0 Clone Local Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.orgslm.desktop",
